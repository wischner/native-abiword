 {
+    // Preserve paragraphs and wrap long diagnostics at UTF-8 boundaries.
+    std::vector<std::string> message_lines(const std::string &message,
+                                            const native::font_t &font,
+                                            int width) {
+        std::vector<std::string> lines(1);
+        for (std::size_t offset = 0; offset < message.size();) {
+            if (message[offset] == '\n') {
+                lines.emplace_back();
+                ++offset;
+                continue;
+            }
+            const auto start = offset++;
+            while (offset < message.size() &&
+                   (static_cast<unsigned char>(message[offset]) & 0xc0) == 0x80)
+                ++offset;
+            auto &line = lines.back();
+            const auto previous = line.size();
+            line.append(message, start, offset - start);
+            if (previous && font.measure_text(line).width > width) {
+                const auto space = line.find_last_of(' ');
+                const auto split = space != std::string::npos && space > 0
+                    ? space : previous;
+                auto remainder = line.substr(split + (split == space ? 1 : 0));
+                line.resize(split);
+                lines.push_back(std::move(remainder));
+            }
+        }
+        return lines;
+    }
